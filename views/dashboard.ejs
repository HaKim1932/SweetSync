<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard — SweetSync</title>
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css"
    rel="stylesheet"
  />
  <style>
    body {
      background-color: #fff8f9;
    }
    .btn-pink {
      background-color: #e91e8c;
      color: #fff;
      border: none;
    }
    .btn-pink:hover {
      background-color: #c4177a;
      color: #fff;
    }
    .text-pink {
      color: #e91e8c;
    }
    .stat-card {
      border: none;
      border-radius: 12px;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    }
    .stat-icon {
      width: 52px;
      height: 52px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
    }
    .orders-card {
      border: none;
      border-radius: 12px;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    }
    .status-badge-pending {
      background-color: #fff3cd;
      color: #856404;
    }
    .status-badge-completed {
      background-color: #d1e7dd;
      color: #0a3622;
    }
    .status-badge-cancelled {
      background-color: #f8d7da;
      color: #842029;
    }
    .status-badge-processing {
      background-color: #cfe2ff;
      color: #084298;
    }
  </style>
</head>
<body>

  <div class="container py-5">

    <!-- Welcome Header -->
    <div class="mb-5">
      <h2 class="fw-bold text-pink mb-1">
        <i class="bi bi-house-heart me-2"></i>Welcome back,
        <%= user.fullname %>!
      </h2>
      <p class="text-muted mb-0">
        Here is a summary of your orders with SweetSync.
      </p>
    </div>

    <!-- Stat Cards -->
    <div class="row g-4 mb-5">

      <!-- Total Orders -->
      <div class="col-sm-6 col-lg-4">
        <div class="card stat-card h-100">
          <div class="card-body d-flex align-items-center gap-3 p-4">
            <div class="stat-icon bg-light text-pink">
              <i class="bi bi-bag-check"></i>
            </div>
            <div>
              <div class="text-muted small">Total Orders</div>
              <div class="fw-bold fs-3 text-pink">
                <%= counts.total || 0 %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Pending Orders -->
      <div class="col-sm-6 col-lg-4">
        <div class="card stat-card h-100">
          <div class="card-body d-flex align-items-center gap-3 p-4">
            <div class="stat-icon" style="background-color:#fff3cd;">
              <i class="bi bi-clock-history" style="color:#856404;"></i>
            </div>
            <div>
              <div class="text-muted small">Pending</div>
              <div class="fw-bold fs-3" style="color:#856404;">
                <%= counts.pending || 0 %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Completed Orders -->
      <div class="col-sm-6 col-lg-4">
        <div class="card stat-card h-100">
          <div class="card-body d-flex align-items-center gap-3 p-4">
            <div class="stat-icon" style="background-color:#d1e7dd;">
              <i class="bi bi-check-circle" style="color:#0a3622;"></i>
            </div>
            <div>
              <div class="text-muted small">Completed</div>
              <div class="fw-bold fs-3" style="color:#0a3622;">
                <%= counts.completed || 0 %>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Recent Orders Table -->
    <div class="card orders-card">
      <div class="card-body p-4">

        <div class="d-flex justify-content-between
                    align-items-center mb-4">
          <h5 class="fw-bold mb-0">
            <i class="bi bi-clock-history me-2 text-pink"></i>
            Recent Orders
          </h5>
          <a href="/orders" class="btn btn-pink btn-sm">
            <i class="bi bi-list-ul me-1"></i>View All Orders
          </a>
        </div>

        <% if (recentOrders.length === 0) { %>

          <!-- No Orders -->
          <div class="text-center py-4">
            <i class="bi bi-bag-x"
               style="font-size: 3rem; color: #dee2e6;"></i>
            <h6 class="mt-3 text-muted">No orders yet</h6>
            <p class="text-muted small mb-3">
              Start shopping and your orders will appear here.
            </p>
            <a href="/products" class="btn btn-pink btn-sm">
              <i class="bi bi-shop me-1"></i>Browse Products
            </a>
          </div>

        <% } else { %>

          <div class="table-responsive">
            <table class="table align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th class="ps-3">Order ID</th>
                  <th>Date</th>
                  <th>Total</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% recentOrders.forEach((order) => { %>
                <tr>

                  <!-- Order ID -->
                  <td class="ps-3 fw-semibold text-pink">
                    #<%= order.id %>
                  </td>

                  <!-- Date -->
                  <td class="text-muted small">
                    <%= new Date(order.created_at)
                          .toLocaleDateString('en-PH', {
                            year:  'numeric',
                            month: 'short',
                            day:   'numeric'
                          }) %>
                  </td>

                  <!-- Total -->
                  <td class="fw-semibold">
                    &#8369;<%= parseFloat(order.total).toFixed(2) %>
                  </td>

                  <!-- Status Badge -->
                  <td>
<% if (order.status === 'Pending') { %>
  <span class="badge status-badge-pending">
    <i class="bi bi-clock me-1"></i>Pending
  </span>
<% } else if (order.status === 'Completed') { %>
  <span class="badge status-badge-completed">
    <i class="bi bi-check-circle me-1"></i>Completed
  </span>
<% } else if (order.status === 'Cancelled') { %>
  <span class="badge status-badge-cancelled">
    <i class="bi bi-x-circle me-1"></i>Cancelled
  </span>
<% } else { %>
  <span class="badge status-badge-processing">
    <i class="bi bi-arrow-repeat me-1"></i><%= order.status %>
  </span>
<% } %>
                  </td>

                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>

        <% } %>

      </div>
    </div>

    <!-- Quick Links -->
    <div class="row g-3 mt-4">
      <div class="col-sm-6 col-md-3">
        <a href="/products"
           class="btn btn-outline-secondary w-100">
          <i class="bi bi-shop me-1"></i>Browse Products
        </a>
      </div>
      <div class="col-sm-6 col-md-3">
        <a href="/cart"
           class="btn btn-outline-secondary w-100">
          <i class="bi bi-cart3 me-1"></i>View Cart
        </a>
      </div>
      <div class="col-sm-6 col-md-3">
        <a href="/orders"
           class="btn btn-outline-secondary w-100">
          <i class="bi bi-bag me-1"></i>My Orders
        </a>
      </div>
      <div class="col-sm-6 col-md-3">
        <a href="/auth/logout"
           class="btn btn-outline-danger w-100">
          <i class="bi bi-box-arrow-right me-1"></i>Logout
        </a>
      </div>
    </div>

  </div>

  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
  ></script>
</body>
</html>