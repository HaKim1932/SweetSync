    <!DOCTYPE html>
<html>
<head>
    <title>My Cart</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
</head>

<body class="container mt-5">

<h1 class="mb-4">
    Shopping Cart
</h1>

<% if (items.length === 0) { %>

    <div class="alert alert-info">
        Cart is empty
    </div>

    <a
        href="/products"
        class="btn btn-primary"
    >
        Browse Products
    </a>

<% } else { %>

    <table class="table table-bordered">

        <thead>
            <tr>
                <th>Product</th>
                <th>Price</th>
                <th width="180">Quantity</th>
                <th>Subtotal</th>
                <th width="120">Action</th>
            </tr>
        </thead>

        <tbody>

        <% items.forEach(item => { %>

            <tr>

                <td>
                    <%= item.name %>
                </td>

                <td>
                    ₱<%= Number(item.price).toFixed(2) %>
                </td>

                <td>

                    <div class="d-flex align-items-center gap-2">

                        <form
                            action="/cart/decrease/<%= item.cart_item_id %>"
                            method="POST"
                        >
                            <button
                                type="submit"
                                class="btn btn-warning btn-sm"
                            >
                                -
                            </button>
                        </form>

                        <strong>
                            <%= item.quantity %>
                        </strong>

                        <form
                            action="/cart/increase/<%= item.cart_item_id %>"
                            method="POST"
                        >
                            <button
                                type="submit"
                                class="btn btn-success btn-sm"
                            >
                                +
                            </button>
                        </form>

                    </div>

                </td>

                <td>
                    ₱<%= Number(item.subtotal).toFixed(2) %>
                </td>

                <td>

                    <form
                        action="/cart/remove/<%= item.cart_item_id %>"
                        method="POST"
                        onsubmit="return confirm('Remove this item?')"
                    >
                        <button
                            type="submit"
                            class="btn btn-danger btn-sm"
                        >
                            Remove
                        </button>
                    </form>

                </td>

            </tr>

        <% }) %>

        </tbody>

    </table>

    <div class="text-end mb-4">

        <h3>
            Total:
            ₱<%= Number(grandTotal).toFixed(2) %>
        </h3>

    </div>

    <a
        href="/orders/checkout"
        class="btn btn-success"
    >
        Checkout
    </a>

    <a
        href="/products"
        class="btn btn-secondary"
    >
        Continue Shopping
    </a>

<% } %>

</body>
</html>