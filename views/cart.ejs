<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>My Cart — SweetSync</title>
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
    rel="stylesheet"
  />
  <style>
    body {
      background-color: #fff8f9;
    }
    .btn-pink {
      background-color: #e91e8c;
      color: #fff;
      border: none;
    }
    .btn-pink:hover {
      background-color: #c4177a;
      color: #fff;
    }
    .text-pink {
      color: #e91e8c;
    }
    .cart-card {
      border: none;
      border-radius: 12px;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    }
    .summary-card {
      border: none;
      border-radius: 12px;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
      position: sticky;
      top: 20px;
    }
    .mobile-item-card {
      border: none;
      border-radius: 10px;
      box-shadow: 0 1px 6px rgba(0, 0, 0, 0.07);
      background: #fff;
      padding: 16px;
      margin-bottom: 12px;
    }
    .qty-btn {
      width: 32px;
      height: 32px;
      padding: 0;
      line-height: 1;
    }
  </style>
</head>
<body>

  <%- include('partials/navbar') %>

  <div class="container py-5">

    <!-- Page Header -->
    <div class="mb-4">
      <h2 class="fw-bold text-pink mb-0">
        <i class="bi bi-cart3 me-2"></i>My Cart
      </h2>
      <p class="text-muted mt-1">Review your items before checkout.</p>
    </div>

    <% if (items.length === 0) { %>

      <!-- Empty State -->
      <div class="cart-card card">
        <div class="card-body text-center py-5">
          <i class="bi bi-cart-x"
             style="font-size: 4rem; color: #dee2e6;"></i>
          <h4 class="mt-3 text-muted">Your cart is empty</h4>
          <p class="text-muted">
            Looks like you haven't added anything yet.
          </p>
          <a href="/products" class="btn btn-pink mt-2">
            <i class="bi bi-shop me-1"></i>Browse Products
          </a>
        </div>
      </div>

    <% } else { %>

    <div class="row g-4">

      <!-- Cart Items Column -->
      <div class="col-lg-8">

        <!-- Desktop Table — hidden on mobile -->
        <div class="cart-card card d-none d-md-block">
          <div class="card-body p-0">
            <table class="table align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th class="ps-4 py-3">Product</th>
                  <th class="py-3">Price</th>
                  <th class="text-center py-3">Quantity</th>
                  <th class="py-3">Subtotal</th>
                  <th class="text-center py-3">Remove</th>
                </tr>
              </thead>
              <tbody>
                <% items.forEach((item) => { %>
                <tr>

                  <!-- Product Name -->
                  <td class="ps-4 fw-semibold">
                    <%= item.name %>
                  </td>

                  <!-- Unit Price -->
                  <td>
                    &#8369;<%= Number(item.price).toFixed(2) %>
                  </td>

                  <!-- Quantity Controls -->
                  <td class="text-center">
                    <div class="d-flex align-items-center
                                justify-content-center gap-2">

                      <form
                        action="/cart/decrease/<%= item.cart_item_id %>"
                        method="POST"
                      >
                        <button
                          type="submit"
                          class="btn btn-outline-secondary btn-sm qty-btn"
                          title="Decrease"
                        >
                          <i class="bi bi-dash"></i>
                        </button>
                      </form>

                      <span class="fw-semibold"
                            style="min-width:24px; text-align:center;">
                        <%= item.quantity %>
                      </span>

                      <form
                        action="/cart/increase/<%= item.cart_item_id %>"
                        method="POST"
                      >
                        <button
                          type="submit"
                          class="btn btn-outline-secondary btn-sm qty-btn"
                          title="Increase"
                        >
                          <i class="bi bi-plus"></i>
                        </button>
                      </form>

                    </div>
                  </td>

                  <!-- Subtotal -->
                  <td class="fw-semibold text-pink">
                    &#8369;<%= Number(item.subtotal).toFixed(2) %>
                  </td>

                  <!-- Remove -->
                  <td class="text-center">
                    <form
                      action="/cart/remove/<%= item.cart_item_id %>"
                      method="POST"
                      onsubmit="return confirm('Remove this item?')"
                    >
                      <button
                        type="submit"
                        class="btn btn-outline-danger btn-sm"
                        title="Remove"
                      >
                        <i class="bi bi-trash3"></i>
                      </button>
                    </form>
                  </td>

                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Mobile Cards — shown only on small screens -->
        <div class="d-md-none">
          <% items.forEach((item) => { %>
          <div class="mobile-item-card">

            <!-- Product Name and Remove -->
            <div class="d-flex justify-content-between
                        align-items-start mb-3">
              <span class="fw-semibold"><%= item.name %></span>
              <form
                action="/cart/remove/<%= item.cart_item_id %>"
                method="POST"
                onsubmit="return confirm('Remove this item?')"
              >
                <button
                  type="submit"
                  class="btn btn-outline-danger btn-sm"
                  title="Remove"
                >
                  <i class="bi bi-trash3"></i>
                </button>
              </form>
            </div>

            <!-- Price, Quantity Controls, Subtotal -->
            <div class="d-flex justify-content-between
                        align-items-center flex-wrap gap-2">

              <small class="text-muted">
                &#8369;<%= Number(item.price).toFixed(2) %> each
              </small>

              <div class="d-flex align-items-center gap-2">
                <form
                  action="/cart/decrease/<%= item.cart_item_id %>"
                  method="POST"
                >
                  <button
                    type="submit"
                    class="btn btn-outline-secondary btn-sm qty-btn"
                  >
                    <i class="bi bi-dash"></i>
                  </button>
                </form>

                <span class="fw-semibold"
                      style="min-width:24px; text-align:center;">
                  <%= item.quantity %>
                </span>

                <form
                  action="/cart/increase/<%= item.cart_item_id %>"
                  method="POST"
                >
                  <button
                    type="submit"
                    class="btn btn-outline-secondary btn-sm qty-btn"
                  >
                    <i class="bi bi-plus"></i>
                  </button>
                </form>
              </div>

              <span class="fw-bold text-pink">
                &#8369;<%= Number(item.subtotal).toFixed(2) %>
              </span>

            </div>

          </div>
          <% }) %>
        </div>

      </div>

      <!-- Order Summary Column -->
      <div class="col-lg-4">
        <div class="summary-card card">
          <div class="card-body p-4">

            <h5 class="fw-bold mb-4">Order Summary</h5>

            <!-- Per Item Breakdown -->
            <% items.forEach((item) => { %>
            <div class="d-flex justify-content-between mb-2">
              <span class="text-muted small" style="max-width:65%;">
                <%= item.name %>
                <small class="d-block">
                  <%= item.quantity %> &times;
                  &#8369;<%= Number(item.price).toFixed(2) %>
                </small>
              </span>
              <span class="small">
                &#8369;<%= Number(item.subtotal).toFixed(2) %>
              </span>
            </div>
            <% }) %>

            <hr class="my-3" />

            <!-- Grand Total -->
            <div class="d-flex justify-content-between
                        align-items-center mb-4">
              <span class="fw-bold fs-5">Total</span>
              <span class="fw-bold fs-5 text-pink">
                &#8369;<%= Number(grandTotal).toFixed(2) %>
              </span>
            </div>

            <!-- Checkout -->
            <a
              href="/orders/checkout"
              class="btn btn-pink w-100 fw-semibold mb-2"
            >
              <i class="bi bi-bag-check me-1"></i>Checkout
            </a>

            <!-- Continue Shopping -->
            <a
              href="/products"
              class="btn btn-outline-secondary w-100"
            >
              <i class="bi bi-arrow-left me-1"></i>Continue Shopping
            </a>

          </div>
        </div>
      </div>

    </div>

    <% } %>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
