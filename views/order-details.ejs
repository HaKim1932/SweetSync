<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Order Details - SweetSync</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
    rel="stylesheet"
  />

  <style>
    body {
      background-color: #fff8f9;
    }

    .text-pink {
      color: #e91e8c;
    }

    .btn-pink {
      background-color: #e91e8c;
      color: #fff;
      border: none;
    }

    .btn-pink:hover {
      background-color: #c4177a;
      color: #fff;
    }

    .card-custom {
      border: none;
      border-radius: 12px;
      box-shadow: 0 2px 12px rgba(0,0,0,.08);
    }

    .proof-img {
      max-width: 100%;
      max-height: 350px;
      border-radius: 12px;
      object-fit: contain;
      border: 1px solid #dee2e6;
    }
  </style>
</head>

<body>

<%- include('partials/navbar') %>

<div class="container py-5">

  <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h2 class="fw-bold text-pink mb-0">
      <i class="bi bi-receipt me-2"></i>
      Order #<%= orderId %>
    </h2>

    <a href="/orders" class="btn btn-outline-secondary btn-sm">
      <i class="bi bi-arrow-left me-1"></i>
      Back to Orders
    </a>
  </div>

  <div class="row g-4">

    <div class="col-lg-8">

      <div class="card card-custom mb-4">
        <div class="card-body p-4">

          <h5 class="fw-bold mb-3">
            <i class="bi bi-bag-check me-2 text-pink"></i>
            Ordered Items
          </h5>

          <% if (items.length === 0) { %>

            <div class="text-center py-4">
              <p class="text-muted mb-0">
                No items found for this order.
              </p>
            </div>

          <% } else { %>

            <div class="table-responsive">
              <table class="table align-middle mb-0">
                <thead class="table-light">
                  <tr>
                    <th>Product</th>
                    <th>Price</th>
                    <th class="text-center">Quantity</th>
                    <th class="text-end">Subtotal</th>
                  </tr>
                </thead>

                <tbody>
                  <% items.forEach((item) => { %>
                    <tr>
                      <td class="fw-semibold">
                        <%= item.name %>
                      </td>

                      <td>
                        &#8369;<%= parseFloat(item.price).toFixed(2) %>
                      </td>

                      <td class="text-center">
                        <%= item.quantity %>
                      </td>

                      <td class="text-end fw-semibold">
                        &#8369;<%= (parseFloat(item.price) * item.quantity).toFixed(2) %>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>

          <% } %>

        </div>
      </div>

    </div>

    <div class="col-lg-4">

      <div class="card card-custom mb-4">
        <div class="card-body p-4">

          <h5 class="fw-bold mb-3">
            <i class="bi bi-cash-coin me-2 text-pink"></i>
            Payment Proof
          </h5>

          <% if (order.payment_proof) { %>

            <p class="text-success small fw-semibold mb-2">
              <i class="bi bi-check-circle me-1"></i>
              Payment proof uploaded
            </p>

            <img
              src="/<%= order.payment_proof %>"
              alt="Payment Proof"
              class="proof-img mb-3"
            />

            <a
              href="/<%= order.payment_proof %>"
              target="_blank"
              class="btn btn-outline-secondary btn-sm w-100"
            >
              <i class="bi bi-eye me-1"></i>
              View Full Image
            </a>

          <% } else { %>

            <p class="text-muted small">
              Upload your GCash/Maya payment screenshot here.
            </p>

            <form
              action="/orders/<%= orderId %>/upload-proof"
              method="POST"
              enctype="multipart/form-data"
            >
              <input
                type="file"
                name="payment_proof"
                class="form-control mb-3"
                accept="image/*"
                required
              />

              <button
                type="submit"
                class="btn btn-pink w-100"
              >
                <i class="bi bi-upload me-1"></i>
                Upload Proof
              </button>
            </form>

          <% } %>

        </div>
      </div>

      <div class="card card-custom">
        <div class="card-body p-4">
          <h6 class="text-muted mb-1">Order Total</h6>
          <h3 class="fw-bold text-pink mb-0">
            &#8369;<%= parseFloat(order.total).toFixed(2) %>
          </h3>
        </div>
      </div>

    </div>

  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>