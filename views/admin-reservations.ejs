<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Admin Reservations — SweetSync</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
    rel="stylesheet"
  />

  <style>
    body {
      background-color: #fff8f9;
    }

    .text-pink {
      color: #e91e8c;
    }

    .btn-pink {
      background-color: #e91e8c;
      color: #fff;
      border: none;
    }

    .btn-pink:hover {
      background-color: #c4177a;
      color: #fff;
    }

    .reservation-card {
      border: none;
      border-radius: 12px;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    }

    .mobile-reservation-card {
      border: none;
      border-radius: 12px;
      background-color: #fff;
      box-shadow: 0 1px 8px rgba(0, 0, 0, 0.08);
      padding: 16px;
      margin-bottom: 14px;
    }

    .form-select:focus {
      border-color: #e91e8c;
      box-shadow: 0 0 0 0.2rem rgba(233, 30, 140, 0.15);
    }
  </style>
</head>

<body>

<%- include('partials/navbar') %>

<div class="container py-5">

  <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
      <h2 class="fw-bold text-pink mb-1">
        <i class="bi bi-calendar-heart me-2"></i>
        Cake Reservations
      </h2>
      <p class="text-muted mb-0">
        Review and update customer cake reservation requests.
      </p>
    </div>

    <a href="/admin" class="btn btn-outline-secondary btn-sm">
      <i class="bi bi-arrow-left me-1"></i>
      Back to Dashboard
    </a>
  </div>

  <% if (reservations.length === 0) { %>

    <div class="reservation-card card">
      <div class="card-body text-center py-5">
        <i
          class="bi bi-calendar-x"
          style="font-size: 4rem; color: #dee2e6;"
        ></i>

        <h4 class="mt-3 text-muted">
          No reservations yet
        </h4>

        <p class="text-muted mb-0">
          Customer cake reservations will appear here.
        </p>
      </div>
    </div>

  <% } else { %>

    <!-- Desktop Table -->
    <div class="reservation-card card d-none d-lg-block">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">

            <thead class="table-light">
              <tr>
                <th class="ps-4 py-3">Customer</th>
                <th class="py-3">Cake</th>
                <th class="py-3">Pickup</th>
                <th class="py-3">Message</th>
                <th class="py-3">Instructions</th>
                <th class="py-3">Status</th>
                <th class="py-3">Update</th>
              </tr>
            </thead>

            <tbody>
              <% reservations.forEach((reservation) => { %>
              <tr>
                <td class="ps-4 fw-semibold">
                  <%= reservation.fullname %>
                </td>

                <td class="fw-semibold text-pink">
                  <%= reservation.cake_name %>
                </td>

                <td>
                  <div>
                    <%= new Date(reservation.pickup_date).toLocaleDateString('en-PH', {
                      year: 'numeric',
                      month: 'short',
                      day: 'numeric'
                    }) %>
                  </div>
                  <small class="text-muted">
                    <%= reservation.pickup_time %>
                  </small>
                </td>

                <td>
                  <%= reservation.message_on_cake || '-' %>
                </td>

                <td style="max-width: 220px;">
                  <small>
                    <%= reservation.instructions || '-' %>
                  </small>
                </td>

                <td>
                  <% if (reservation.status === 'Pending') { %>
                    <span class="badge bg-warning text-dark">
                      Pending
                    </span>
                  <% } else if (reservation.status === 'Approved') { %>
                    <span class="badge bg-success">
                      Approved
                    </span>
                  <% } else if (reservation.status === 'Rejected') { %>
                    <span class="badge bg-danger">
                      Rejected
                    </span>
                  <% } else if (reservation.status === 'Ready') { %>
                    <span class="badge bg-primary">
                      Ready
                    </span>
                  <% } else { %>
                    <span class="badge bg-secondary">
                      <%= reservation.status %>
                    </span>
                  <% } %>
                </td>

                <td>
                  <form
                    action="/admin/reservations/<%= reservation.id %>/status"
                    method="POST"
                    class="d-flex gap-2"
                  >
                    <select
                      name="status"
                      class="form-select form-select-sm"
                      style="max-width: 130px;"
                    >
                      <option value="Pending" <%= reservation.status === 'Pending' ? 'selected' : '' %>>
                        Pending
                      </option>

                      <option value="Approved" <%= reservation.status === 'Approved' ? 'selected' : '' %>>
                        Approved
                      </option>

                      <option value="Rejected" <%= reservation.status === 'Rejected' ? 'selected' : '' %>>
                        Rejected
                      </option>

                      <option value="Ready" <%= reservation.status === 'Ready' ? 'selected' : '' %>>
                        Ready
                      </option>
                    </select>

                    <button
                      type="submit"
                      class="btn btn-pink btn-sm"
                    >
                      Update
                    </button>
                  </form>
                </td>
              </tr>
              <% }) %>
            </tbody>

          </table>
        </div>
      </div>
    </div>

    <!-- Mobile Cards -->
    <div class="d-lg-none">
      <% reservations.forEach((reservation) => { %>
      <div class="mobile-reservation-card">

        <div class="d-flex justify-content-between align-items-start mb-2">
          <div>
            <div class="fw-bold text-pink">
              <%= reservation.cake_name %>
            </div>

            <small class="text-muted">
              <%= reservation.fullname %>
            </small>
          </div>

          <% if (reservation.status === 'Pending') { %>
            <span class="badge bg-warning text-dark">
              Pending
            </span>
          <% } else if (reservation.status === 'Approved') { %>
            <span class="badge bg-success">
              Approved
            </span>
          <% } else if (reservation.status === 'Rejected') { %>
            <span class="badge bg-danger">
              Rejected
            </span>
          <% } else if (reservation.status === 'Ready') { %>
            <span class="badge bg-primary">
              Ready
            </span>
          <% } else { %>
            <span class="badge bg-secondary">
              <%= reservation.status %>
            </span>
          <% } %>
        </div>

        <div class="small text-muted mb-2">
          <strong>Pickup:</strong>
          <%= new Date(reservation.pickup_date).toLocaleDateString('en-PH', {
            year: 'numeric',
            month: 'short',
            day: 'numeric'
          }) %>
          at
          <%= reservation.pickup_time %>
        </div>

        <div class="small text-muted mb-1">
          <strong>Message:</strong>
          <%= reservation.message_on_cake || '-' %>
        </div>

        <div class="small text-muted mb-3">
          <strong>Instructions:</strong>
          <%= reservation.instructions || '-' %>
        </div>

        <form
          action="/admin/reservations/<%= reservation.id %>/status"
          method="POST"
          class="d-grid gap-2"
        >
          <select
            name="status"
            class="form-select form-select-sm"
          >
            <option value="Pending" <%= reservation.status === 'Pending' ? 'selected' : '' %>>
              Pending
            </option>

            <option value="Approved" <%= reservation.status === 'Approved' ? 'selected' : '' %>>
              Approved
            </option>

            <option value="Rejected" <%= reservation.status === 'Rejected' ? 'selected' : '' %>>
              Rejected
            </option>

            <option value="Ready" <%= reservation.status === 'Ready' ? 'selected' : '' %>>
              Ready
            </option>
          </select>

          <button
            type="submit"
            class="btn btn-pink btn-sm"
          >
            <i class="bi bi-check2-circle me-1"></i>
            Update Status
          </button>
        </form>

      </div>
      <% }) %>
    </div>

  <% } %>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>