<!DOCTYPE html>
<html>
<head>
    <title>Admin Dashboard</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
        rel="stylesheet"
    >
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body>

<%- include('partials/navbar') %>

<div class="container mt-5">

    <h1 class="mb-3">
        Admin Dashboard
    </h1>

    <p class="text-muted">
        Welcome <%= user.fullname %>
    </p>

    <!-- Summary Cards -->
    <div class="row mt-4">

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm border-primary">
                <div class="card-body">
                    <h5>
                        <i class="bi bi-box-seam"></i>
                        Total Products
                    </h5>

                    <h2>
                        <%= totalProducts %>
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm border-success">
                <div class="card-body">
                    <h5>
                        <i class="bi bi-bag-check"></i>
                        Total Orders
                    </h5>

                    <h2>
                        <%= totalOrders %>
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm border-warning">
                <div class="card-body">
                    <h5>
                        <i class="bi bi-cash-stack"></i>
                        Revenue
                    </h5>

                    <h2>
                        ₱<%= report.totalRevenue || 0 %>
                    </h2>
                </div>
            </div>
        </div>

    </div>

    <!-- Sales Report -->
    <div class="card shadow-sm mt-4">

        <div class="card-header">
            <h4 class="mb-0">
                <i class="bi bi-graph-up-arrow"></i>
                Sales Report
            </h4>
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-3 mb-3">
                    <div class="border rounded p-3 text-center">
                        <h6>Total Orders</h6>

                        <h3>
                            <%= report.totalOrders || 0 %>
                        </h3>
                    </div>
                </div>

                <div class="col-md-3 mb-3">
                    <div class="border rounded p-3 text-center">
                        <h6>Pending Orders</h6>

                        <h3 class="text-warning">
                            <%= report.pendingOrders || 0 %>
                        </h3>
                    </div>
                </div>

                <div class="col-md-3 mb-3">
                    <div class="border rounded p-3 text-center">
                        <h6>Completed Orders</h6>

                        <h3 class="text-success">
                            <%= report.completedOrders || 0 %>
                        </h3>
                    </div>
                </div>

                <div class="col-md-3 mb-3">
                    <div class="border rounded p-3 text-center">
                        <h6>Total Revenue</h6>

                        <h3 class="text-primary">
                            ₱<%= report.totalRevenue || 0 %>
                        </h3>
                    </div>
                </div>

            </div>

        </div>

    </div>

        <!-- Low Stock Alerts -->
    <div class="card shadow-sm mt-4">

        <div class="card-header bg-warning-subtle">
            <h4 class="mb-0">
                <i class="bi bi-exclamation-triangle"></i>
                Low Stock Alerts
            </h4>
        </div>

        <div class="card-body">

            <% if (lowStockProducts.length === 0) { %>

                <div class="text-center py-4">
                    <i
                        class="bi bi-check-circle"
                        style="font-size: 3rem; color: #198754;"
                    ></i>

                    <p class="text-muted mt-3 mb-0">
                        All products have enough stock.
                    </p>
                </div>

            <% } else { %>

                <div class="table-responsive">
                    <table class="table align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>Product</th>
                                <th>Category</th>
                                <th class="text-center">Stock Left</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% lowStockProducts.forEach((product) => { %>
                            <tr>
                                <td class="fw-semibold">
                                    <%= product.name %>
                                </td>

                                <td>
                                    <span class="badge bg-light text-dark border">
                                        <%= product.category || 'N/A' %>
                                    </span>
                                </td>

                                <td class="text-center">
                                    <% if (product.stock <= 0) { %>
                                        <span class="badge bg-danger">
                                            Out of Stock
                                        </span>
                                    <% } else { %>
                                        <span class="badge bg-warning text-dark">
                                            Only <%= product.stock %> left
                                        </span>
                                    <% } %>
                                </td>

                                <td class="text-end">
                                    <a
                                        href="/products/edit/<%= product.id %>"
                                        class="btn btn-outline-warning btn-sm"
                                    >
                                        <i class="bi bi-pencil-square me-1"></i>
                                        Update Stock
                                    </a>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>

                    </table>
                </div>

            <% } %>

        </div>

    </div>

    <!-- Charts -->
<div class="card shadow-sm mt-4">

    <div class="card-header">
        <h4 class="mb-0">
            <i class="bi bi-bar-chart"></i>
            Analytics Dashboard
        </h4>
    </div>

    <div class="card-body">

        <div class="row">

            <div class="col-lg-6 mb-4">
                <h6 class="text-center">Revenue Bar Chart</h6>
                <canvas id="revenueChart"></canvas>
            </div>

            <div class="col-lg-6 mb-4">
                <h6 class="text-center">Orders Line Chart</h6>
                <canvas id="ordersChart"></canvas>
            </div>

        </div>

        <div class="row">
            <div class="col-lg-8 mx-auto">
                <h6 class="text-center">Top Products Pie Chart</h6>
                <canvas id="pieChart"></canvas>
            </div>
        </div>

    </div>

</div>
    
    <!-- Top Selling Products -->
    <div class="card shadow-sm mt-4">

        <div class="card-header">
            <h4 class="mb-0">
                <i class="bi bi-trophy"></i>
                Top Selling Products
            </h4>
        </div>

        <div class="card-body">

            <% if (topProducts.length === 0) { %>

                <div class="text-center py-4">
                    <i
                        class="bi bi-bar-chart-line"
                        style="font-size: 3rem; color: #dee2e6;"
                    ></i>

                    <p class="text-muted mt-3 mb-0">
                        No sales data available yet.
                    </p>
                </div>

            <% } else { %>

                <div class="table-responsive">

                    <table class="table align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>Rank</th>
                                <th>Product</th>
                                <th>Category</th>
                                <th class="text-center">
                                    Units Sold
                                </th>
                                <th class="text-end">
                                    Total Revenue
                                </th>
                            </tr>
                        </thead>

                        <tbody>

                            <% topProducts.forEach((product, index) => { %>

                            <tr>

                                <td>
                                    <% if (index === 0) { %>

                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-trophy-fill me-1"></i>
                                            1st
                                        </span>

                                    <% } else if (index === 1) { %>

                                        <span class="badge bg-secondary">
                                            <i class="bi bi-trophy me-1"></i>
                                            2nd
                                        </span>

                                    <% } else if (index === 2) { %>

                                        <span class="badge bg-danger">
                                            <i class="bi bi-trophy me-1"></i>
                                            3rd
                                        </span>

                                    <% } else { %>

                                        <span class="text-muted fw-semibold">
                                            <%= index + 1 %>th
                                        </span>

                                    <% } %>
                                </td>

                                <td class="fw-semibold">
                                    <%= product.name %>
                                </td>

                                <td>
                                    <span class="badge bg-light text-dark border">
                                        <%= product.category || 'N/A' %>
                                    </span>
                                </td>

                                <td class="text-center">

                                    <span class="fw-bold text-success">
                                        <%= product.total_quantity %>
                                    </span>

                                    <small class="text-muted d-block">
                                        units
                                    </small>

                                </td>

                                <td class="text-end fw-bold">
                                    ₱<%= parseFloat(product.total_revenue).toFixed(2) %>
                                </td>

                            </tr>

                            <% }) %>

                        </tbody>

                    </table>

                </div>

            <% } %>

        </div>

    </div>

    <!-- Navigation Buttons -->
    <div class="mt-4 mb-5">

        <a
            href="/products"
            class="btn btn-primary"
        >
            Manage Products
        </a>

        <a
            href="/admin/orders"
            class="btn btn-success"
        >
            View Orders
        </a>

        <a
            href="/dashboard"
            class="btn btn-secondary"
        >
            User Dashboard
        </a>

    </div>

</div>

<script type="application/json" id="monthlyRevenueData">
<%- JSON.stringify(monthlyRevenue || []) %>
</script>

<script type="application/json" id="monthlyOrdersData">
<%- JSON.stringify(monthlyOrders || []) %>
</script>

<script type="application/json" id="productSalesPieData">
<%- JSON.stringify(productSalesPie || []) %>
</script>

<script>
    const monthlyRevenue =
        JSON.parse(
            document.getElementById("monthlyRevenueData").textContent
        );

    const monthlyOrders =
        JSON.parse(
            document.getElementById("monthlyOrdersData").textContent
        );

    const productSalesPie =
        JSON.parse(
            document.getElementById("productSalesPieData").textContent
        );

    new Chart(
        document.getElementById("revenueChart"),
        {
            type: "bar",
            data: {
                labels: monthlyRevenue.map(r => r.month),
                datasets: [
                    {
                        label: "Revenue",
                        data: monthlyRevenue.map(r => Number(r.revenue)),
                        backgroundColor: "rgba(233, 30, 140, 0.6)"
                    }
                ]
            }
        }
    );

    new Chart(
        document.getElementById("ordersChart"),
        {
            type: "line",
            data: {
                labels: monthlyOrders.map(o => o.month),
                datasets: [
                    {
                        label: "Orders",
                        data: monthlyOrders.map(o => Number(o.order_count)),
                        fill: false,
                        borderColor: "rgba(25, 135, 84, 0.8)",
                        tension: 0.3
                    }
                ]
            }
        }
    );

    new Chart(
        document.getElementById("pieChart"),
        {
            type: "pie",
            data: {
                labels: productSalesPie.map(p => p.name),
                datasets: [
                    {
                        data: productSalesPie.map(p => Number(p.total_sold))
                    }
                ]
            }
        }
    );
</script>
</body>
</html>