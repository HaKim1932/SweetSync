<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Reserve Cake — SweetSync</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
    rel="stylesheet"
  />

  <style>
    body {
      background-color: #fff8f9;
    }

    .text-pink {
      color: #e91e8c;
    }

    .btn-pink {
      background-color: #e91e8c;
      color: #fff;
      border: none;
    }

    .btn-pink:hover {
      background-color: #c4177a;
      color: #fff;
    }

    .reservation-card {
      border: none;
      border-radius: 14px;
      box-shadow: 0 2px 14px rgba(0, 0, 0, 0.08);
    }

    .form-control:focus,
    .form-select:focus {
      border-color: #e91e8c;
      box-shadow: 0 0 0 0.2rem rgba(233, 30, 140, 0.15);
    }
  </style>
</head>

<body>

<%- include('../partials/navbar') %>

<div class="container py-5">

  <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
      <h2 class="fw-bold text-pink mb-1">
        <i class="bi bi-calendar-heart me-2"></i>Reserve a Cake
      </h2>
      <p class="text-muted mb-0">
        Submit a cake reservation request for your special occasion.
      </p>
    </div>

    <a href="/reservations" class="btn btn-outline-secondary btn-sm">
      <i class="bi bi-clock-history me-1"></i>My Reservations
    </a>
  </div>

  <div class="card reservation-card">
    <div class="card-body p-4">

      <form action="/reservations/new" method="POST">

        <div class="row g-3">

          <div class="col-md-6">
            <label class="form-label fw-semibold">
              Cake Name / Type
            </label>
            <select
  name="cake_name"
  class="form-select"
  required
>
  <option value="">Select cake type</option>
  <option value="Birthday Cake">Birthday Cake</option>
  <option value="Wedding Cake">Wedding Cake</option>
  <option value="Customized Cake">Customized Cake</option>
  <option value="Bento Cake">Bento Cake</option>
  <option value="Number Cake">Number Cake</option>
  <option value="Tiered Cake">Tiered Cake</option>
  <option value="Fondant Cake">Fondant Cake</option>
  <option value="Cupcake Tower">Cupcake Tower</option>
  <option value="Dessert Table Package">Dessert Table Package</option>
</select>
          </div>

          <div class="col-md-3">
            <label class="form-label fw-semibold">
              Pickup Date
            </label>
            <input
              type="date"
              name="pickup_date"
              class="form-control"
              required
            />
          </div>

          <div class="col-md-3">
            <label class="form-label fw-semibold">
              Pickup Time
            </label>
            <input
              type="time"
              name="pickup_time"
              class="form-control"
              required
            />
          </div>

          <div class="col-12">
            <label class="form-label fw-semibold">
              Message on Cake
            </label>
            <input
              type="text"
              name="message_on_cake"
              class="form-control"
              placeholder="e.g. Happy Birthday, Kim!"
            />
          </div>

          <div class="col-12">
            <label class="form-label fw-semibold">
              Special Instructions
            </label>
            <textarea
              name="instructions"
              class="form-control"
              rows="4"
              placeholder="Design, colors, size, flavor, allergies, or other requests..."
            ></textarea>
          </div>

        </div>

        <div class="d-flex justify-content-end gap-2 mt-4 flex-wrap">
          <a href="/products" class="btn btn-outline-secondary">
            Cancel
          </a>

          <button type="submit" class="btn btn-pink">
            <i class="bi bi-send me-1"></i>Submit Reservation
          </button>
        </div>

      </form>

    </div>
  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>