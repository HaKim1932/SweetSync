<!DOCTYPE html>
<html>
<head>
    <title>My Cart</title>
</head>
<body>

<h1>Shopping Cart</h1>

<% if(items.length === 0) { %>

    <p>Cart is empty</p>

<% } else { %>

    <% items.forEach(item => { %>

        <h3>
            <%= item.name %>
        </h3>

        <p>
            Price:
            ₱<%= item.price %>
        </p>

        <p>
            Quantity:
            <%= item.quantity %>
        </p>

        <hr>

    <% }) %>

<% } %>
<br>

<a href="/orders/checkout">
    Checkout
</a>

<br><br>
<a href="/products">
    Back to Products
</a>

</body>
</html>