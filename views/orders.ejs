<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>My Orders — SweetSync</title>
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
    rel="stylesheet"
  />
  <style>
    body {
      background-color: #fff8f9;
    }
    .btn-pink {
      background-color: #e91e8c;
      color: #fff;
      border: none;
    }
    .btn-pink:hover {
      background-color: #c4177a;
      color: #fff;
    }
    .text-pink {
      color: #e91e8c;
    }
    .orders-card {
      border: none;
      border-radius: 12px;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    }
    .order-row-mobile {
      border: none;
      border-radius: 10px;
      box-shadow: 0 1px 6px rgba(0, 0, 0, 0.07);
      margin-bottom: 12px;
      background: #fff;
      padding: 16px;
    }
  </style>
</head>
<body>

  <%- include('partials/navbar') %>

  <div class="container py-5">

    <!-- Page Header -->
    <div class="d-flex justify-content-between
                align-items-center mb-4 flex-wrap gap-2">
      <h2 class="fw-bold text-pink mb-0">
        <i class="bi bi-bag-heart me-2"></i>My Orders
      </h2>
      <a href="/products" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Back to Products
      </a>
    </div>

    <% if (orders.length === 0) { %>

      <!-- Empty State -->
      <div class="orders-card card">
        <div class="card-body text-center py-5">
          <i class="bi bi-bag-x"
             style="font-size: 4rem; color: #dee2e6;"></i>
          <h4 class="mt-3 text-muted">No orders yet</h4>
          <p class="text-muted">
            Start shopping and your orders will appear here.
          </p>
          <a href="/products" class="btn btn-pink mt-2">
            <i class="bi bi-shop me-1"></i>Browse Products
          </a>
        </div>
      </div>

    <% } else { %>

      <!-- Desktop Table — hidden on mobile -->
      <div class="orders-card card d-none d-md-block">
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">

              <thead class="table-light">
                <tr>
                  <th class="ps-4 py-3">Order</th>
                  <th class="py-3">Date</th>
                  <th class="py-3">Total</th>
                  <th class="py-3">Status</th>
                  <th class="text-end pe-4 py-3">Action</th>
                </tr>
              </thead>

              <tbody>
                <% orders.forEach((order) => { %>
                <tr>

                  <!-- Order ID -->
                  <td class="ps-4 fw-semibold text-pink">
                    #<%= order.id %>
                  </td>

                  <!-- Date -->
                  <td class="text-muted small">
                    <%= new Date(order.created_at)
                          .toLocaleDateString('en-PH', {
                            year:  'numeric',
                            month: 'short',
                            day:   'numeric'
                          }) %>
                  </td>

                  <!-- Total -->
                  <td class="fw-semibold">
                    &#8369;<%= parseFloat(order.total).toFixed(2) %>
                  </td>

                  <!-- Status Badge -->
                  <td>
                    <% if (order.status === 'Pending') { %>
                      <span class="badge bg-warning text-dark">
                        <i class="bi bi-clock me-1"></i>Pending
                      </span>
                    <% } else if (order.status === 'Processing') { %>
                      <span class="badge bg-primary">
                        <i class="bi bi-arrow-repeat me-1"></i>Processing
                      </span>
                    <% } else if (order.status === 'Completed') { %>
                      <span class="badge bg-success">
                        <i class="bi bi-check-circle me-1"></i>Completed
                      </span>
                    <% } else if (order.status === 'Cancelled') { %>
                      <span class="badge bg-danger">
                        <i class="bi bi-x-circle me-1"></i>Cancelled
                      </span>
                    <% } else { %>
                      <span class="badge bg-secondary">
                        <%= order.status %>
                      </span>
                    <% } %>
                  </td>

                  <!-- Action -->
                  <td class="text-end pe-4">
                    <a
                      href="/orders/<%= order.id %>"
                      class="btn btn-sm btn-outline-secondary"
                    >
                      <i class="bi bi-eye me-1"></i>View Details
                    </a>
                  </td>

                </tr>
                <% }) %>
              </tbody>

            </table>
          </div>
        </div>
      </div>

      <!-- Mobile Cards — shown only on small screens -->
      <div class="d-md-none">
        <% orders.forEach((order) => { %>
        <div class="order-row-mobile">

          <div class="d-flex justify-content-between
                      align-items-start mb-2">
            <span class="fw-bold text-pink">
              Order #<%= order.id %>
            </span>
            <% if (order.status === 'Pending') { %>
              <span class="badge bg-warning text-dark">
                <i class="bi bi-clock me-1"></i>Pending
              </span>
            <% } else if (order.status === 'Processing') { %>
              <span class="badge bg-primary">
                <i class="bi bi-arrow-repeat me-1"></i>Processing
              </span>
            <% } else if (order.status === 'Completed') { %>
              <span class="badge bg-success">
                <i class="bi bi-check-circle me-1"></i>Completed
              </span>
            <% } else if (order.status === 'Cancelled') { %>
              <span class="badge bg-danger">
                <i class="bi bi-x-circle me-1"></i>Cancelled
              </span>
            <% } else { %>
              <span class="badge bg-secondary">
                <%= order.status %>
              </span>
            <% } %>
          </div>

          <div class="d-flex justify-content-between
                      align-items-center">
            <div>
              <div class="fw-semibold">
                &#8369;<%= parseFloat(order.total).toFixed(2) %>
              </div>
              <small class="text-muted">
                <%= new Date(order.created_at)
                      .toLocaleDateString('en-PH', {
                        year:  'numeric',
                        month: 'short',
                        day:   'numeric'
                      }) %>
              </small>
            </div>
            <a
              href="/orders/<%= order.id %>"
              class="btn btn-sm btn-outline-secondary"
            >
              <i class="bi bi-eye me-1"></i>Details
            </a>
          </div>

        </div>
        <% }) %>
      </div>

    <% } %>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
