<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Admin Users — SweetSync</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
    rel="stylesheet"
  />

  <style>
    body {
      background-color: #fff8f9;
    }

    .text-pink {
      color: #e91e8c;
    }

    .btn-pink {
      background-color: #e91e8c;
      color: #fff;
      border: none;
    }

    .btn-pink:hover {
      background-color: #c4177a;
      color: #fff;
    }

    .users-card {
      border: none;
      border-radius: 12px;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    }

    .mobile-user-card {
      border: none;
      border-radius: 12px;
      background-color: #fff;
      box-shadow: 0 1px 8px rgba(0, 0, 0, 0.08);
      padding: 16px;
      margin-bottom: 14px;
    }
  </style>
</head>

<body>

<%- include('partials/navbar') %>

<div class="container py-5">

  <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
      <h2 class="fw-bold text-pink mb-1">
        <i class="bi bi-people me-2"></i>
        User Management
      </h2>
      <p class="text-muted mb-0">
        Manage user roles and account status.
      </p>
    </div>

    <a href="/admin" class="btn btn-outline-secondary btn-sm">
      <i class="bi bi-arrow-left me-1"></i>
      Back to Dashboard
    </a>
  </div>

  <% if (users.length === 0) { %>

    <div class="users-card card">
      <div class="card-body text-center py-5">
        <i
          class="bi bi-person-x"
          style="font-size: 4rem; color: #dee2e6;"
        ></i>

        <h4 class="mt-3 text-muted">
          No users found
        </h4>
      </div>
    </div>

  <% } else { %>

    <!-- Desktop Table -->
    <div class="users-card card d-none d-md-block">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">

            <thead class="table-light">
              <tr>
                <th class="ps-4 py-3">User</th>
                <th class="py-3">Email</th>
                <th class="py-3">Role</th>
                <th class="py-3">Status</th>
                <th class="py-3">Update Role</th>
                <th class="py-3">Account</th>
              </tr>
            </thead>

            <tbody>
              <% if (user.id === userItem.id) { %>

<span class="badge bg-info">
    Current User
</span>

<% } else { %>

<!-- Existing activate/deactivate form here -->

<% } %>
              <tr>
                <td class="ps-4 fw-semibold">
                  <%= userItem.fullname %>
                </td>

                <td class="text-muted">
                  <%= userItem.email %>
                </td>

                <td>
                  <% if (userItem.role === 'admin') { %>
                    <span class="badge bg-primary">
                      Admin
                    </span>
                  <% } else { %>
                    <span class="badge bg-secondary">
                      Customer
                    </span>
                  <% } %>
                </td>

                <td>
                  <% if (userItem.is_active == 1) { %>
                    <span class="badge bg-success">
                      Active
                    </span>
                  <% } else { %>
                    <span class="badge bg-danger">
                      Deactivated
                    </span>
                  <% } %>
                </td>

                <td>
                  <form
                    action="/admin/users/<%= userItem.id %>/role"
                    method="POST"
                    class="d-flex gap-2"
                  >
                    <select
                      name="role"
                      class="form-select form-select-sm"
                      style="max-width: 140px;"
                    >
                      <option value="customer" <%= userItem.role === 'customer' ? 'selected' : '' %>>
                        Customer
                      </option>

                      <option value="admin" <%= userItem.role === 'admin' ? 'selected' : '' %>>
                        Admin
                      </option>
                    </select>

                    <button
                      type="submit"
                      class="btn btn-pink btn-sm"
                    >
                      Update
                    </button>
                  </form>
                </td>

                <td>
                  <form
                    action="/admin/users/<%= userItem.id %>/status"
                    method="POST"
                  >
                    <% if (userItem.is_active == 1) { %>
                      <input
                        type="hidden"
                        name="is_active"
                        value="0"
                      />

                      <button
                        type="submit"
                        class="btn btn-outline-danger btn-sm"
                        onclick="return confirm('Deactivate this user?')"
                      >
                        Deactivate
                      </button>
                    <% } else { %>
                      <input
                        type="hidden"
                        name="is_active"
                        value="1"
                      />

                      <button
                        type="submit"
                        class="btn btn-outline-success btn-sm"
                      >
                        Activate
                      </button>
                    <% } %>
                  </form>
                </td>
              </tr>
              <% }) %>
            </tbody>

          </table>
        </div>
      </div>
    </div>

    <!-- Mobile Cards -->
    <div class="d-md-none">
      <% users.forEach((userItem) => { %>
        
        <% if (user.id === userItem.id) { %>

<span class="badge bg-info">
    Current User
</span>

<% } else { %>

<!-- Existing activate/deactivate form here -->

<% } %>
      <div class="mobile-user-card">

        <div class="mb-2">
          <div class="fw-bold text-pink">
            <%= userItem.fullname %>
          </div>

          <small class="text-muted">
            <%= userItem.email %>
          </small>
        </div>

        <div class="mb-3 d-flex gap-2 flex-wrap">
          <% if (userItem.role === 'admin') { %>
            <span class="badge bg-primary">
              Admin
            </span>
          <% } else { %>
            <span class="badge bg-secondary">
              Customer
            </span>
          <% } %>

          <% if (userItem.is_active == 1) { %>
            <span class="badge bg-success">
              Active
            </span>
          <% } else { %>
            <span class="badge bg-danger">
              Deactivated
            </span>
          <% } %>
        </div>

        <form
          action="/admin/users/<%= userItem.id %>/role"
          method="POST"
          class="d-grid gap-2 mb-2"
        >
          <select
            name="role"
            class="form-select form-select-sm"
          >
            <option value="customer" <%= userItem.role === 'customer' ? 'selected' : '' %>>
              Customer
            </option>

            <option value="admin" <%= userItem.role === 'admin' ? 'selected' : '' %>>
              Admin
            </option>
          </select>

          <button
            type="submit"
            class="btn btn-pink btn-sm"
          >
            Update Role
          </button>
        </form>

        <form
          action="/admin/users/<%= userItem.id %>/status"
          method="POST"
          class="d-grid"
        >
          <% if (userItem.is_active == 1) { %>
            <input
              type="hidden"
              name="is_active"
              value="0"
            />

            <button
              type="submit"
              class="btn btn-outline-danger btn-sm"
              onclick="return confirm('Deactivate this user?')"
            >
              Deactivate User
            </button>
          <% } else { %>
            <input
              type="hidden"
              name="is_active"
              value="1"
            />

            <button
              type="submit"
              class="btn btn-outline-success btn-sm"
            >
              Activate User
            </button>
          <% } %>
        </form>

      </div>
      <% }) %>
    </div>

  <% } %>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>