<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Login — SweetSync</title>
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
    rel="stylesheet"
  />
  <style>
    body {
      background-color: #fff8f9;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .btn-pink {
      background-color: #e91e8c;
      color: #fff;
      border: none;
    }
    .btn-pink:hover {
      background-color: #c4177a;
      color: #fff;
    }
    .text-pink {
      color: #e91e8c;
    }
    .brand-header {
      background-color: #e91e8c;
      border-radius: 12px 12px 0 0;
    }
    .login-card {
      border: none;
      border-radius: 12px;
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.10);
      width: 100%;
      max-width: 420px;
    }
    .form-control:focus {
      border-color: #e91e8c;
      box-shadow: 0 0 0 0.2rem rgba(233, 30, 140, 0.15);
    }
  </style>
</head>
<body>

  <div class="login-card card">

    <div class="brand-header text-white text-center py-4 px-3">
      <i class="bi bi-cake2 fs-1"></i>
      <h3 class="fw-bold mt-2 mb-0">SweetSync</h3>
      <p class="mb-0 opacity-75 small">Smart Bakery Management System</p>
    </div>

    <div class="card-body p-4">

      <h5 class="fw-bold text-center mb-4">Welcome Back</h5>

      <form action="/api/users/login" method="POST">

        <div class="mb-3">
          <label class="form-label fw-semibold">
            <i class="bi bi-envelope me-1 text-pink"></i>Email
          </label>
          <input
            type="email"
            name="email"
            class="form-control"
            placeholder="Enter your email"
            required
          />
        </div>

        <div class="mb-4">
          <label class="form-label fw-semibold">
            <i class="bi bi-lock me-1 text-pink"></i>Password
          </label>
          <input
            type="password"
            name="password"
            class="form-control"
            placeholder="Enter your password"
            required
          />
        </div>

        <button type="submit" class="btn btn-pink w-100 fw-semibold py-2">
          <i class="bi bi-box-arrow-in-right me-1"></i>Login
        </button>

      </form>

    </div>

    <div class="card-footer bg-white text-center py-3 border-0 rounded-bottom">
      <span class="text-muted small">Don't have an account?</span>
      <a href="/auth/register" class="text-pink fw-semibold text-decoration-none ms-1 small">
        Register here
      </a>
    </div>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
