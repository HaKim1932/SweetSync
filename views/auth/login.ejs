<!DOCTYPE html>
<html>
<head>
    <title>SweetSync Login</title>
</head>
<body>

<h1>Login</h1>

<form action="/api/users/login" method="POST">

    <input
        type="email"
        name="email"
        placeholder="Email"
        required
    >

    <br><br>

    <input
        type="password"
        name="password"
        placeholder="Password"
        required
    >

    <br><br>

    <button type="submit">
        Login
    </button>

</form>

<br>

<a href="/auth/register">
    Register
</a>

</body>
</html>