<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Products - SweetSync</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css"
    rel="stylesheet"
  />

  <style>
    body {
      background-color: #fff8f9;
    }

    .btn-pink {
      background-color: #e91e8c;
      color: white;
      border: none;
    }

    .btn-pink:hover {
      background-color: #c4177a;
      color: white;
    }

    .text-pink {
      color: #e91e8c;
    }

    .product-card {
      border: none;
      border-radius: 12px;
      box-shadow: 0 2px 12px rgba(0,0,0,.08);
      transition: .2s ease;
    }

    .product-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 6px 20px rgba(0,0,0,.12);
    }

    .category-btn.active-category {
      background-color: #e91e8c;
      border-color: #e91e8c;
      color: white;
    }

    #suggestionsBox {
      top: 100%;
      left: 0;
      right: 0;
      z-index: 1000;
    }
  </style>
</head>

<body>

<%- include('../partials/navbar') %>

<div class="container py-5">

  <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h2 class="fw-bold text-pink mb-0">
      <i class="bi bi-shop me-2"></i>Our Products
    </h2>

    <div class="d-flex gap-2">
      <a href="/cart" class="btn btn-outline-success btn-sm">
        <i class="bi bi-cart3 me-1"></i>View Cart
      </a>

      <a href="/products/add" class="btn btn-pink btn-sm">
        <i class="bi bi-plus-circle me-1"></i>Add Product
      </a>
    </div>
  </div>

  <form
    method="GET"
    action="/products"
    class="mb-4 position-relative"
  >
    <div class="input-group">

      <input
        type="text"
        name="search"
        id="searchInput"
        class="form-control"
        placeholder="Search products..."
        value="<%= currentSearch %>"
        autocomplete="off"
      />

      <input
        type="hidden"
        name="category"
        value="<%= currentCategory %>"
      />

      <button type="submit" class="btn btn-pink">
        <i class="bi bi-search me-1"></i>Search
      </button>

      <% if (currentSearch !== '' || currentCategory !== '') { %>
        <a href="/products" class="btn btn-outline-secondary">
          <i class="bi bi-x-circle me-1"></i>Clear
        </a>
      <% } %>

    </div>

    <div
      id="suggestionsBox"
      class="list-group position-absolute w-100 shadow-sm"
    ></div>
  </form>

  <% if (categories.length > 0) { %>

    <div class="mb-4 d-flex flex-wrap gap-2">

      <a
        href="/products?search=<%= currentSearch %>"
        class="btn btn-outline-secondary btn-sm category-btn <%= currentCategory === '' ? 'active-category' : '' %>"
      >
        All
      </a>

      <% categories.forEach((cat) => { %>

        <a
          href="/products?search=<%= currentSearch %>&category=<%= encodeURIComponent(cat) %>"
          class="btn btn-outline-secondary btn-sm category-btn <%= currentCategory === cat ? 'active-category' : '' %>"
        >
          <%= cat %>
        </a>

      <% }) %>

    </div>

  <% } %>

  <p class="text-muted small mb-3">
    <% if (currentSearch !== '' || currentCategory !== '') { %>
      Showing <%= products.length %> result<%= products.length !== 1 ? 's' : '' %>
    <% } else { %>
      Showing all <%= products.length %> product<%= products.length !== 1 ? 's' : '' %>
    <% } %>
  </p>

  <% if (products.length === 0) { %>

    <div class="text-center py-5">
      <i
        class="bi bi-search"
        style="font-size:4rem;color:#dee2e6;"
      ></i>

      <h4 class="mt-3 text-muted">
        No products found
      </h4>

      <p class="text-muted">
        Try a different search term or category.
      </p>

      <a href="/products" class="btn btn-pink mt-2">
        <i class="bi bi-arrow-left me-1"></i>View All Products
      </a>
    </div>

  <% } else { %>

    <div class="row g-4">

      <% products.forEach((product) => { %>

        <div class="col-sm-6 col-lg-4">

          <div class="card product-card h-100">

            <img
              src="/<%= product.image %>"
              class="card-img-top"
              alt="<%= product.name %>"
              style="height:220px;object-fit:cover;border-radius:12px 12px 0 0;"
            />

            <div class="card-body d-flex flex-column">

              <% if (product.category) { %>
                <span
                  class="badge bg-light text-pink border mb-2"
                  style="width:fit-content;"
                >
                  <%= product.category %>
                </span>
              <% } %>

              <% if (product.stock <= 0) { %>
                <span
                  class="badge bg-danger mb-2"
                  style="width:fit-content;"
                >
                  <i class="bi bi-x-circle me-1"></i>
                  Out of Stock
                </span>
              <% } else if (product.stock <= 5) { %>
                <span
                  class="badge bg-warning text-dark mb-2"
                  style="width:fit-content;"
                >
                  <i class="bi bi-exclamation-triangle me-1"></i>
                  Only <%= product.stock %> left
                </span>
              <% } %>

              <h5 class="card-title fw-bold">
                <%= product.name %>
              </h5>

              <p class="card-text text-muted small flex-grow-1">
                <%= product.description %>
              </p>

              <div class="d-flex justify-content-between align-items-center mb-3">

                <span class="fw-bold text-pink fs-5">
                  ₱<%= parseFloat(product.price).toFixed(2) %>
                </span>

                <small class="text-muted">
                  Stock: <%= product.stock %>
                </small>

              </div>

              <div class="d-flex gap-2 flex-wrap">

                <% if (product.stock <= 0) { %>

                  <button
                    class="btn btn-secondary btn-sm flex-grow-1"
                    disabled
                  >
                    <i class="bi bi-x-circle me-1"></i>
                    Out of Stock
                  </button>

                <% } else { %>

                  <a
                    href="/cart/add/<%= product.id %>"
                    class="btn btn-pink btn-sm flex-grow-1"
                  >
                    <i class="bi bi-cart-plus me-1"></i>
                    Add to Cart
                  </a>

                <% } %>

                <a
                  href="/products/edit/<%= product.id %>"
                  class="btn btn-outline-warning btn-sm"
                >
                  <i class="bi bi-pencil"></i>
                </a>

                <a
                  href="/products/delete/<%= product.id %>"
                  class="btn btn-outline-danger btn-sm"
                  onclick="return confirm('Delete this product?')"
                >
                  <i class="bi bi-trash3"></i>
                </a>

              </div>

            </div>
          </div>

        </div>

      <% }) %>

    </div>

  <% } %>
<% if (totalPages > 1) { %>

  <nav class="mt-5">
    <ul class="pagination justify-content-center">

      <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
        <a
          class="page-link"
          href="/products?search=<%= encodeURIComponent(currentSearch) %>&category=<%= encodeURIComponent(currentCategory) %>&page=<%= currentPage - 1 %>"
        >
          Previous
        </a>
      </li>

      <% for (let i = 1; i <= totalPages; i++) { %>
        <li class="page-item <%= currentPage === i ? 'active' : '' %>">
          <a
            class="page-link"
            href="/products?search=<%= encodeURIComponent(currentSearch) %>&category=<%= encodeURIComponent(currentCategory) %>&page=<%= i %>"
          >
            <%= i %>
          </a>
        </li>
      <% } %>

      <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
        <a
          class="page-link"
          href="/products?search=<%= encodeURIComponent(currentSearch) %>&category=<%= encodeURIComponent(currentCategory) %>&page=<%= currentPage + 1 %>"
        >
          Next
        </a>
      </li>

    </ul>
  </nav>

<% } %>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script>
  $(document).ready(function () {
    $("#searchInput").on("keyup", function () {
      const keyword = $(this).val();

      if (keyword.length < 2) {
        $("#suggestionsBox").empty();
        return;
      }

      $.ajax({
        url: "/products/suggestions",
        method: "GET",
        data: {
          keyword: keyword
        },
        success: function (data) {
          let html = "";

          if (data.length === 0) {
            html = `
              <div class="list-group-item text-muted">
                No suggestions found
              </div>
            `;
          } else {
            data.forEach(function (product) {
              html += `
                <a
                  href="/products?search=${encodeURIComponent(product.name)}"
                  class="list-group-item list-group-item-action"
                >
                  ${product.name}
                </a>
              `;
            });
          }

          $("#suggestionsBox").html(html);
        }
      });
    });

    $(document).on("click", function (e) {
      if (
        !$(e.target).closest("#searchInput, #suggestionsBox").length
      ) {
        $("#suggestionsBox").empty();
      }
    });
  });
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>