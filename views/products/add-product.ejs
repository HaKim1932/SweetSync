<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Add Product — SweetSync</title>
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
    rel="stylesheet"
  />
  <style>
    body {
      background-color: #fff8f9;
    }
    .btn-pink {
      background-color: #e91e8c;
      color: #fff;
      border: none;
    }
    .btn-pink:hover {
      background-color: #c4177a;
      color: #fff;
    }
    .text-pink {
      color: #e91e8c;
    }
    .form-control:focus,
    .form-select:focus {
      border-color: #e91e8c;
      box-shadow: 0 0 0 0.2rem rgba(233, 30, 140, 0.15);
    }
    .form-card {
      border: none;
      border-radius: 12px;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    }
  </style>
</head>
<body>

  <%- include('../partials/navbar') %>

  <div class="container py-5">
    <div class="row justify-content-center">
      <div class="col-12 col-md-8 col-lg-6">

        <!-- Page Header -->
        <div class="mb-4">
          <a href="/products" class="btn btn-outline-secondary btn-sm mb-3">
            <i class="bi bi-arrow-left me-1"></i>Back to Products
          </a>
          <h2 class="fw-bold text-pink mb-0">
            <i class="bi bi-plus-circle me-2"></i>Add Product
          </h2>
          <p class="text-muted mt-1">Fill in the details to add a new product.</p>
        </div>

        <!-- Form Card -->
        <div class="form-card card">
          <div class="card-body p-4">

            <form
              action="/products/add"
              method="POST"
              enctype="multipart/form-data"
            >

              <!-- Product Name -->
              <div class="mb-3">
                <label class="form-label fw-semibold">
                  <i class="bi bi-tag me-1 text-pink"></i>Product Name
                </label>
                <input
                  type="text"
                  name="name"
                  class="form-control"
                  placeholder="Enter product name"
                  required
                />
              </div>

              <!-- Description -->
              <div class="mb-3">
                <label class="form-label fw-semibold">
                  <i class="bi bi-text-left me-1 text-pink"></i>Description
                </label>
                <textarea
                  name="description"
                  class="form-control"
                  rows="3"
                  placeholder="Enter product description"
                ></textarea>
              </div>

              <!-- Price and Stock -->
              <div class="row g-3 mb-3">
                <div class="col-6">
                  <label class="form-label fw-semibold">
                    <i class="bi bi-cash me-1 text-pink"></i>Price (₱)
                  </label>
                  <input
                    type="number"
                    step="0.01"
                    name="price"
                    class="form-control"
                    placeholder="0.00"
                    required
                  />
                </div>
                <div class="col-6">
                  <label class="form-label fw-semibold">
                    <i class="bi bi-boxes me-1 text-pink"></i>Stock
                  </label>
                  <input
                    type="number"
                    name="stock"
                    class="form-control"
                    placeholder="0"
                    required
                  />
                </div>
              </div>

              <!-- Category -->
              <div class="mb-3">
                <label class="form-label fw-semibold">
                  <i class="bi bi-grid me-1 text-pink"></i>Category
                </label>
                <input
                  type="text"
                  name="category"
                  class="form-control"
                  placeholder="e.g. Cakes, Pastries, Breads"
                />
              </div>

              <!-- Product Image -->
              <div class="mb-4">
                <label class="form-label fw-semibold">
                  <i class="bi bi-image me-1 text-pink"></i>Product Image
                </label>
                <input
                  type="file"
                  name="image"
                  class="form-control"
                  accept="image/*"
                />
                <div class="form-text text-muted">
                  Accepted formats: JPG, PNG, WEBP
                </div>
              </div>

              <!-- Submit -->
              <div class="d-flex gap-2">
                <button type="submit" class="btn btn-pink flex-grow-1 fw-semibold py-2">
                  <i class="bi bi-plus-circle me-1"></i>Add Product
                </button>
                <a href="/products" class="btn btn-outline-secondary py-2">
                  Cancel
                </a>
              </div>

            </form>

          </div>
        </div>

      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
