<!DOCTYPE html>
<html>
<head>
    <title>Edit Product</title>
</head>
<body>

<h1>Edit Product</h1>

<form
    action="/products/edit/<%= product.id %>"
    method="POST"
>

    <label>Product Name</label>
    <br>
    <input
        type="text"
        name="name"
        value="<%= product.name %>"
        required
    >

    <br><br>

    <label>Description</label>
    <br>
    <textarea
        name="description"
        required
    ><%= product.description %></textarea>

    <br><br>

    <label>Price</label>
    <br>
    <input
        type="number"
        step="0.01"
        name="price"
        value="<%= product.price %>"
        required
    >

    <br><br>

    <label>Stock</label>
    <br>
    <input
        type="number"
        name="stock"
        value="<%= product.stock %>"
        required
    >

    <br><br>

    <label>Category</label>
    <br>
    <input
        type="text"
        name="category"
        value="<%= product.category %>"
        required
    >

    <br><br>

    <button type="submit">
        Update Product
    </button>

</form>

</body>
</html>